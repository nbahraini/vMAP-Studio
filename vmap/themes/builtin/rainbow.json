{
  "schema_version": 1,
  "id": "rainbow",
  "name": "Rainbow Branches",
  "version": 1,
  "author": "VMap Studio contributors",
  "license": "CC0-1.0",
  "description": "Each main branch gets its own colour.",
  "background": "#FBFBFD",
  "line_style": "curve",
  "colored_branches": true,
  "branch_colors": ["#C62828", "#D84315", "#2E7D32", "#1565C0", "#6A1B9A", "#00838F", "#AD1457"],
  "branch_color_targets": {"main": ["fill", "border", "line_color"], "sub": ["line_color"]},
  "h_gap": 34, "v_gap": 12, "root_gap": 60,
  "levels": {
    "root": {"shape": "pill", "fill": "#263238", "border": "#263238", "border_width": 2,
             "text_color": "#FFFFFF", "font_size": 19, "bold": true, "padding_x": 26, "padding_y": 12},
    "main": {"shape": "pill", "text_color": "#FFFFFF", "font_size": 14, "bold": true,
             "padding_x": 16, "padding_y": 7, "line_width": 3},
    "sub":  {"shape": "underline", "fill": "none", "text_color": "#263238", "font_size": 12,
             "padding_x": 6, "padding_y": 4, "line_width": 1.8}
  }
}
